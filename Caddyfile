}

# The network-asset app redirects to HTTPS unless told the hop was already secure.
http://assets.home.arpa {
    reverse_proxy localhost:3002 {
        header_up X-Forwarded-Proto https
    }
}

http://assets-staging.home.arpa {
    reverse_proxy localhost:3001 {
        header_up X-Forwarded-Proto https
    }
}
