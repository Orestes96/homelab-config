#!/usr/bin/env bash
# Usage: sorttv "RIP_FOLDER" "Show Name" SEASON FIRST_EPISODE [MIN_MINUTES] [MAX_MINUTES] [LAST_EPISODE]
# Titles are processed in disc order: the number after the final "_t" in the
# file name, which MakeMKV adds by default.
#   longer than 2.5x MIN_MINUTES      -> treated as "Play All" and DELETED
#   MIN_MINUTES to MAX_MINUTES incl.  -> episode, numbered from FIRST_EPISODE,
#                                        unless it duplicates an episode already
#                                        in the season or earlier on this disc
#                                        (moved to _duplicates/, not numbered)
#   anything else                     -> extras/
# Before numbering, the episode-length titles are checked against the disc's
# Play All length. If they add up to one title too many, the one title that
# explains the excess (for example a 20-minute extras reel in a show whose
# episodes run 18 to 32 minutes) goes to extras/ and is not numbered. If the
# lengths don't add up and no single title explains why, everything is
# numbered as before and a WARNING line says so.
# KEEP_EXTRAS=0 in the show's tv/<Show>/.ripsort deletes extras SHORTER than
# MIN_MINUTES instead (longer oddities still go to extras/ so nothing that
# could be an episode is lost).
# MIN defaults to 18, MAX to MIN+5. Numbering never goes past LAST_EPISODE
# (surplus goes to extras/ with a warning). An episode file that already
# exists is never overwritten. The final line is EPISODES=N for ripwatch.
set -euo pipefail

src="/srv/media/rips/$1"
show="$2"
season="$3"
ep="$4"
min="${5:-18}"
max="${6:-$((min + 5))}"
last="${7:-}"

dest=$(printf "/srv/media/rips/tv/%s/Season %02d" "$show" "$season")
extras="/srv/media/rips/extras/$show"
dupes="/srv/media/rips/_duplicates/$show"
mkdir -p "$dest"

# Per-show setting (only KEEP_EXTRAS is used here; lengths come from the arguments).
KEEP_EXTRAS=1
showcfg="/srv/media/rips/tv/$show/.ripsort"
if [ -f "$showcfg" ]; then
  KEEP_EXTRAS=$(sed -nE 's/^KEEP_EXTRAS=([01])$/\1/p' "$showcfg" | tail -n1)
  KEEP_EXTRAS="${KEEP_EXTRAS:-1}"
fi

minsecs=$((min * 60))
maxsecs=$((max * 60))
playall=$((minsecs * 5 / 2))
found=0

# Fingerprint: exact size plus a hash of 8 MiB from the middle of the file.
# MakeMKV writes a different header and trailer for every title, so the
# ends are skipped; the video in the middle is what identifies a duplicate.
fp() {
  local size
  size=$(stat -c %s "$1")
  printf '%s-%s' "$size" "$(dd if="$1" bs=1M skip=$((size / 2097152)) count=8 status=none | md5sum | cut -d' ' -f1)"
}

to_extras() {
  mkdir -p "$extras"
  mv "$1" "$extras/"
}

# Fingerprints of episodes already in this season.
declare -A seen
for e in "$dest"/*.mkv; do
  [ -e "$e" ] || continue
  seen["$(fp "$e")"]=$(basename "$e")
done

# List .mkv files in disc order.
ordered() {
  for f in "$src"/*.mkv; do
    n=$(basename "$f")
    t=$(printf '%s' "$n" | sed -nE 's/.*_t([0-9]+)\.mkv$/\1/p')
    printf '%s\t%s\n' "${t:-999}" "$f"
  done | sort -n | cut -f2-
}

# Pre-pass: read every title's length once, in disc order.
mapfile -t files < <(ordered)
declare -a lens=()
for i in "${!files[@]}"; do
  lens[i]=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "${files[$i]}" | cut -d. -f1)
done

# Reconcile the episode-length titles with the disc's Play All length(s).
drop=-1
pa_sum=0; pa_max=0; cand_sum=0
declare -A pre=()
for k in "${!seen[@]}"; do pre["$k"]=1; done
declare -a cand_idx=() cand_len=()
for i in "${!files[@]}"; do
  s=${lens[$i]}
  if [ "$s" -ge "$playall" ]; then
    pa_sum=$((pa_sum + s))
    if [ "$s" -gt "$pa_max" ]; then pa_max=$s; fi
  elif [ "$s" -ge "$minsecs" ] && [ "$s" -le "$maxsecs" ]; then
    k=$(fp "${files[$i]}")
    if [ -z "${pre[$k]:-}" ]; then
      pre["$k"]=1
      cand_idx+=("$i"); cand_len+=("$s"); cand_sum=$((cand_sum + s))
    fi
  fi
done
if [ "$pa_sum" -gt 0 ] && [ "${#cand_idx[@]}" -gt 1 ]; then
  d1=$((cand_sum - pa_sum)); d1=${d1#-}
  d2=$((cand_sum - pa_max)); d2=${d2#-}
  if [ "$d1" -gt 90 ] && [ "$d2" -gt 90 ]; then
    if [ "$cand_sum" -gt "$pa_max" ]; then
      best=-1; bestd=999999; second=999999
      for j in "${!cand_idx[@]}"; do
        e1=$((cand_sum - cand_len[j] - pa_sum)); e1=${e1#-}
        e2=$((cand_sum - cand_len[j] - pa_max)); e2=${e2#-}
        e=$e1
        if [ "$e2" -lt "$e" ]; then e=$e2; fi
        if [ "$e" -lt "$bestd" ]; then second=$bestd; bestd=$e; best=$j
        elif [ "$e" -lt "$second" ]; then second=$e; fi
      done
      if [ "$bestd" -le 15 ] && [ $((second - bestd)) -ge 20 ]; then
        echo "WARNING reconcile: episode-length titles add up to $cand_sum s but the play-all is $pa_max s. $(basename "${files[${cand_idx[$best]}]}") (${cand_len[$best]} s) is the one the play-all leaves out. It may be an extra or a real episode, so it is numbered as before; check it by hand."
      else
        echo "WARNING reconcile: episode-length titles add up to $cand_sum s but the play-all is $pa_max s, and no single title explains the difference. Numbering them all; check this disc by hand."
      fi
    elif [ "$cand_sum" -lt "$pa_sum" ] && [ "$cand_sum" -lt "$pa_max" ]; then
      echo "WARNING reconcile: episode-length titles add up to $cand_sum s but the play-all is $pa_max s. An episode may be longer than MAX_MINUTES, or missing."
    fi
  fi
fi

for i in "${!files[@]}"; do
  f="${files[$i]}"
  secs="${lens[$i]}"
  if [ "$secs" -ge "$playall" ]; then
    rm -f "$f"
    echo "Deleted play-all: $(basename "$f")  ($secs s)"
  elif [ "$i" -eq "$drop" ]; then
    to_extras "$f"
    echo "Extra:   $(basename "$f")  ($secs s)"
  elif [ "$secs" -ge "$minsecs" ] && [ "$secs" -le "$maxsecs" ]; then
    key=$(fp "$f")
    name=$(printf "%s - s%02de%02d.mkv" "$show" "$season" "$ep")
    if [ -n "${seen[$key]:-}" ]; then
      mkdir -p "$dupes"
      mv "$f" "$dupes/"
      echo "Duplicate: $(basename "$f")  ($secs s) is the same video as ${seen[$key]}, moved to _duplicates"
    elif [ -n "$last" ] && [ "$ep" -gt "$last" ]; then
      to_extras "$f"
      echo "WARNING over total: $(basename "$f")  ($secs s) sent to extras, series already has $last episodes"
    elif [ -e "$dest/$name" ]; then
      to_extras "$f"
      echo "WARNING exists: $name already on disk, $(basename "$f")  ($secs s) sent to extras"
    else
      mv "$f" "$dest/$name"
      seen["$key"]="$name"
      echo "Episode: $name  ($secs s)"
      ep=$((ep + 1))
      found=$((found + 1))
    fi
  elif [ "$KEEP_EXTRAS" = "0" ] && [ "$secs" -lt "$minsecs" ]; then
    rm -f "$f"
    echo "Deleted extra: $(basename "$f")  ($secs s)"
  else
    to_extras "$f"
    echo "Extra:   $(basename "$f")  ($secs s)"
  fi
done

rm -f "$src/.done" "$src/.pending"
rmdir "$src" 2>/dev/null || echo "Left $src in place (not empty)."
echo "Episodes from this disc: $found"
echo "EPISODES=$found"
