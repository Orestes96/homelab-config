#!/usr/bin/env bash
# Usage: sorttv "RIP_FOLDER" "Show Name" SEASON FIRST_EPISODE [MIN_MINUTES] [MAX_MINUTES] [LAST_EPISODE]
# Titles are processed in disc order: the number after the final "_t" in the
# file name, which MakeMKV adds by default.
#   longer than 2.5x MIN_MINUTES      -> treated as "Play All" and moved to
#                                        _duplicates/ (never deleted: it could be
#                                        a feature-length special)
#   MIN_MINUTES to MAX_MINUTES incl.  -> episode, numbered from FIRST_EPISODE,
#                                        unless it duplicates an episode already
#                                        in the season or earlier on this disc
#                                        (moved to _duplicates/, not numbered)
#   anything else                     -> extras/
# Before numbering, the episode-length titles are checked against the disc's
# Play All length. If they add up to one title too many, the one title that
# explains the excess (for example a 20-minute extras reel in a show whose
# episodes run 18 to 32 minutes) goes to extras/ and is not numbered. If the
# lengths don't add up and no single title explains why, everything is
# numbered as before and a WARNING line says so.
# KEEP_EXTRAS=0 in the show's tv/<Show>/.ripsort deletes extras SHORTER than
# MIN_MINUTES instead (longer oddities still go to extras/ so nothing that
# could be an episode is lost).
# A title whose length ffprobe can't read stops the sort before anything
# moves (exit code 3, so ripwatch parks the disc).
# MIN defaults to 18, MAX to MIN+5. An episode file that already exists is
# never overwritten. The final line is EPISODES=N for ripwatch.
# Split episodes: PARTS_S<n>="EP:COUNT ..." in the show's .ripsort (e.g.
# PARTS_S6="1:2") says episode EP is stored as COUNT consecutive titles. They
# are named "Show - sNNeEE - part1.mkv", "part2"... (Jellyfin's multi-part
# naming) and count as ONE episode for numbering, LAST_EPISODE and EPISODES=N.
# Numbering never goes past LAST_EPISODE: if an episode-length title would,
# nothing moves and the disc is parked (exit 3) with a Problem message, since
# the series may hold a split episode or have the wrong total.
# Resumable: each filed episode is recorded in the rip folder's .sorted-episodes
# straight after it is moved. If a sort stops partway, running it again with
# the same arguments carries on numbering after the episodes already filed.
set -euo pipefail

src="/srv/media/rips/$1"
show="$2"
season="$3"
ep="$4"
min="${5:-18}"
max="${6:-$((min + 5))}"
last="${7:-}"

dest=$(printf "/srv/media/rips/tv/%s/Season %02d" "$show" "$season")
extras="/srv/media/rips/extras/$show"
dupes="/srv/media/rips/_duplicates/$show"
mkdir -p "$dest"

# Per-show settings (KEEP_EXTRAS and PARTS_S<season>; lengths come from the arguments).
KEEP_EXTRAS=1
PARTS=""
showcfg="/srv/media/rips/tv/$show/.ripsort"
if [ -f "$showcfg" ]; then
  KEEP_EXTRAS=$(sed -nE 's/^KEEP_EXTRAS=([01])$/\1/p' "$showcfg" | tail -n1)
  KEEP_EXTRAS="${KEEP_EXTRAS:-1}"
  PARTS=$(sed -nE "s/^PARTS_S0*${season}=[\"']?([0-9: ]*)[\"']?[[:space:]]*\$/\1/p" "$showcfg" | tail -n1)
fi
# Split episodes: NPARTS[episode] = how many titles it is stored as.
declare -A NPARTS=()
for pr in $PARTS; do
  [[ "$pr" =~ ^0*([0-9]+):0*([0-9]+)$ ]] && [ "${BASH_REMATCH[2]}" -ge 2 ] && NPARTS[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
done
nparts() { printf '%s' "${NPARTS[$1]:-1}"; }
# File name for part $2 (0-based) of episode $1.
epname() {
  if [ "$(nparts "$1")" -gt 1 ]; then printf "%s - s%02de%02d - part%d.mkv" "$show" "$season" "$1" "$(($2 + 1))"
  else printf "%s - s%02de%02d.mkv" "$show" "$season" "$1"; fi
}

minsecs=$((min * 60))
maxsecs=$((max * 60))
playall=$((minsecs * 5 / 2))
found=0      # whole episodes filed from this disc (a split episode counts once)
part=0       # parts of episode $ep already filed (0 unless it is split)

# Fingerprint: exact size plus a hash of 8 MiB from the middle of the file.
# MakeMKV writes a different header and trailer for every title, so the
# ends are skipped; the video in the middle is what identifies a duplicate.
fp() {
  local size
  size=$(stat -c %s "$1")
  printf '%s-%s' "$size" "$(dd if="$1" bs=1M skip=$((size / 2097152)) count=8 status=none | md5sum | cut -d' ' -f1)"
}

to_extras() {
  mkdir -p "$extras"
  mv "$1" "$extras/"
}

# Fingerprints of episodes already in this season.
declare -A seen
for e in "$dest"/*.mkv; do
  [ -e "$e" ] || continue
  seen["$(fp "$e")"]=$(basename "$e")
done

# Near-duplicate check (a near-duplicate is a copy of an episode that is not
# byte-identical). A Blu-ray ripped with every title contains each episode
# twice: once as a playlist and once as the raw video file, with the same
# length but a slightly different size, so the fingerprint above misses it.
# A title counts as a copy of an episode already kept from THIS disc when its
# length is within 2 s and its size within 2%. The first one (lower title
# number, the playlist version) is kept; the copy goes to _duplicates/.
declare -a dsecs=() dsize=() dname=()
nd() {  # $1 = length in s, $2 = size in bytes; prints the name of the match
  local j d r
  for j in "${!dsecs[@]}"; do
    d=$(($1 - dsecs[j])); d=${d#-}
    [ "$d" -le 2 ] || continue
    r=$(($2 - dsize[j])); r=${r#-}
    if [ $((r * 100)) -le $((dsize[j] * 2)) ]; then
      printf '%s' "${dname[j]}"
      return 0
    fi
  done
  return 1
}

# List .mkv files in disc order.
ordered() {
  for f in "$src"/*.mkv; do
    n=$(basename "$f")
    t=$(printf '%s' "$n" | sed -nE 's/.*_t([0-9]+)\.mkv$/\1/p')
    printf '%s\t%s\n' "${t:-999}" "$f"
  done | sort -n | cut -f2-
}

# Pre-pass: read every title's length once, in disc order.
mapfile -t files < <(ordered)
declare -a lens=()
for i in "${!files[@]}"; do
  lens[i]=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "${files[$i]}" 2>/dev/null | cut -d. -f1) || lens[i]=""
done
# A title whose length can't be read can't be told apart from an episode, an
# extra or a play-all, so stop before anything moves. Exit 3 = park the disc.
bad=()
for i in "${!files[@]}"; do [[ "${lens[$i]}" =~ ^[0-9]+$ ]] || bad+=("${files[$i]}"); done
if [ "${#bad[@]}" -gt 0 ]; then
  echo "Problem: Unreadable length: ffprobe couldn't read how long ${#bad[@]} title(s) on this disc are, so they can't be sorted:"
  printf '  %s\n' "${bad[@]}"
  echo "How to fix it: check whether the file plays (the first command). If it doesn't, delete it or re-rip the disc; then queue the disc again (the second command):"
  echo
  echo "    ffprobe -v error -show_entries format=duration -of csv=p=0 \"${bad[0]}\""
  echo "    mv \"$src/.pending\" \"$src/.done\""
  echo
  echo "Nothing was changed. The disc is parked as .pending."
  exit 3
fi

# Reconcile the episode-length titles with the disc's Play All length(s).
drop=-1
pa_sum=0; pa_max=0; cand_sum=0
declare -A pre=()
for k in "${!seen[@]}"; do pre["$k"]=1; done
declare -a cand_idx=() cand_len=()
for i in "${!files[@]}"; do
  s=${lens[$i]}
  if [ "$s" -ge "$playall" ]; then
    pa_sum=$((pa_sum + s))
    if [ "$s" -gt "$pa_max" ]; then pa_max=$s; fi
  elif [ "$s" -ge "$minsecs" ] && [ "$s" -le "$maxsecs" ]; then
    k=$(fp "${files[$i]}")
    if [ -z "${pre[$k]:-}" ]; then
      pre["$k"]=1
      sz=$(stat -c %s "${files[$i]}")
      if ! nd "$s" "$sz" >/dev/null; then
        dsecs+=("$s"); dsize+=("$sz"); dname+=("x")
        cand_idx+=("$i"); cand_len+=("$s"); cand_sum=$((cand_sum + s))
      fi
    fi
  fi
done
if [ "$pa_sum" -gt 0 ] && [ "${#cand_idx[@]}" -gt 1 ]; then
  d1=$((cand_sum - pa_sum)); d1=${d1#-}
  d2=$((cand_sum - pa_max)); d2=${d2#-}
  if [ "$d1" -gt 90 ] && [ "$d2" -gt 90 ]; then
    if [ "$cand_sum" -gt "$pa_max" ]; then
      best=-1; bestd=999999; second=999999
      for j in "${!cand_idx[@]}"; do
        e1=$((cand_sum - cand_len[j] - pa_sum)); e1=${e1#-}
        e2=$((cand_sum - cand_len[j] - pa_max)); e2=${e2#-}
        e=$e1
        if [ "$e2" -lt "$e" ]; then e=$e2; fi
        if [ "$e" -lt "$bestd" ]; then second=$bestd; bestd=$e; best=$j
        elif [ "$e" -lt "$second" ]; then second=$e; fi
      done
      if [ "$bestd" -le 15 ] && [ $((second - bestd)) -ge 20 ]; then
        echo "WARNING reconcile: episode-length titles add up to $cand_sum s but the play-all is $pa_max s. $(basename "${files[${cand_idx[$best]}]}") (${cand_len[$best]} s) is the one the play-all leaves out. It may be an extra or a real episode, so it is numbered as before; check it by hand."
      else
        echo "WARNING reconcile: episode-length titles add up to $cand_sum s but the play-all is $pa_max s, and no single title explains the difference. Numbering them all; check this disc by hand."
      fi
    elif [ "$cand_sum" -lt "$pa_sum" ] && [ "$cand_sum" -lt "$pa_max" ]; then
      echo "WARNING reconcile: episode-length titles add up to $cand_sum s but the play-all is $pa_max s. An episode may be longer than MAX_MINUTES, or missing."
    fi
  fi
fi

dsecs=(); dsize=(); dname=()

# Record that part $1 (1-based) of episode $ep was filed, and move on: to the
# next part, or to the next episode once all its parts are in.
advance() {
  if [ "$1" -ge "$(nparts "$ep")" ]; then ep=$((ep + 1)); part=0; found=$((found + 1)); else part=$1; fi
}

# Resume an interrupted sort of this disc: count what it already filed and
# carry on numbering after it. Progress lines are "EP:PART name". The progress
# file is created just before the first move, so its absence means nothing
# from this disc was filed yet.
progress="$src/.sorted-episodes"
fresh=1
if [ -e "$progress" ]; then
  fresh=0
  while read -r tag pname; do
    [ -n "$pname" ] || continue
    pep=${tag%%:*}; pk=${tag#*:}; [ "$pk" = "$tag" ] && pk=1
    ep=$pep; advance "$pk"
    if [ -e "$dest/$pname" ]; then
      dsecs+=("$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$dest/$pname" | cut -d. -f1)")
      dsize+=("$(stat -c %s "$dest/$pname")"); dname+=("$pname")
    fi
  done < "$progress"
  # A stop between a move and its progress line leaves at most one title
  # filed but unrecorded: it has the next name, so count it too.
  next=$(epname "$ep" "$part")
  if [ -e "$dest/$next" ]; then
    printf '%s:%s %s\n' "$ep" "$((part + 1))" "$next" >> "$progress"
    advance "$((part + 1))"
  fi
  echo "Resuming an interrupted sort: $found episodes from this disc were already filed, so numbering carries on from e$ep${part:+$([ "$part" -gt 0 ] && echo " part $((part + 1))")}."
fi

# Before anything moves: would an episode-length title be numbered past the
# series total? Walk the titles that will become episodes (cand_idx: not
# duplicates, not play-alls) exactly as the loop below numbers them. If any
# would go over, park the disc instead of filing a real episode as an extra.
over=(); dep=$ep; dpart=$part
for i in "${cand_idx[@]}"; do
  if [ -n "$last" ] && [ "$dep" -gt "$last" ]; then over+=("$(basename "${files[$i]}")  (${lens[$i]} s)"); continue; fi
  [ -e "$dest/$(epname "$dep" "$dpart")" ] && continue   # goes to extras as "exists", as before
  dpart=$((dpart + 1))
  if [ "$dpart" -ge "$(nparts "$dep")" ]; then dep=$((dep + 1)); dpart=0; fi
done
if [ "${#over[@]}" -gt 0 ]; then
  lens_cmd='for f in "'"$src"'"/*.mkv; do printf "%s  %s s\n" "$(basename "$f")" "$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$f" | cut -d. -f1)"; done'
  echo "Problem: Over the episode total: ${#over[@]} episode-length title(s) on this disc would be numbered past episode $last, the total set for $show series $season (TOTAL_S$season):"
  printf '  %s\n' "${over[@]}"
  echo "How to fix it: the series may contain an episode split across two or more titles (a double-length premiere or finale stored in parts), or its total may be wrong. List this disc's title lengths to compare with the episode list (the first command). See what's already in the season (the second command):"
  echo
  echo "    $lens_cmd"
  echo "    ls \"$dest\""
  echo
  echo "If an episode is split, record it in the show's settings (change 1:2 to the episode number and how many titles it is stored as; if a PARTS_S$season line is already there, add to that line instead), then queue the disc again:"
  echo
  echo "    printf 'PARTS_S$season=\"1:2\"\\n' >> \"$showcfg\" && mv \"$src/.pending\" \"$src/.done\""
  echo
  echo "If the total is wrong, set the right one (change $((last + 1)) to the real number of episodes); this also queues the disc again:"
  echo
  echo "    ~/bin/newseries \"$show\" $season $((last + 1))"
  echo
  echo "Nothing was changed. The disc is parked as .pending."
  exit 3
fi
[ "$fresh" -eq 1 ] && : > "$progress"

for i in "${!files[@]}"; do
  f="${files[$i]}"
  secs="${lens[$i]}"
  if [ "$secs" -ge "$playall" ]; then
    mkdir -p "$dupes"
    mv --backup=numbered "$f" "$dupes/"
    echo "Play-all moved to _duplicates/$show, not deleted: $(basename "$f")  ($secs s)"
  elif [ "$i" -eq "$drop" ]; then
    to_extras "$f"
    echo "Extra:   $(basename "$f")  ($secs s)"
  elif [ "$secs" -ge "$minsecs" ] && [ "$secs" -le "$maxsecs" ]; then
    key=$(fp "$f")
    name=$(epname "$ep" "$part")
    if [ -n "${seen[$key]:-}" ]; then
      mkdir -p "$dupes"
      mv "$f" "$dupes/"
      echo "Duplicate: $(basename "$f")  ($secs s) is the same video as ${seen[$key]}, moved to _duplicates"
    elif nearname=$(nd "$secs" "$(stat -c %s "$f")"); then
      mkdir -p "$dupes"
      mv "$f" "$dupes/"
      echo "Duplicate: $(basename "$f")  ($secs s) has the same length and nearly the same size as $nearname from this disc, so it is a copy, moved to _duplicates"
    elif [ -n "$last" ] && [ "$ep" -gt "$last" ]; then
      to_extras "$f"
      echo "WARNING over total: $(basename "$f")  ($secs s) sent to extras, series already has $last episodes"
    elif [ -e "$dest/$name" ]; then
      to_extras "$f"
      echo "WARNING exists: $name already on disk, $(basename "$f")  ($secs s) sent to extras"
    else
      mv "$f" "$dest/$name"
      printf '%s:%s %s\n' "$ep" "$((part + 1))" "$name" >> "$progress"
      seen["$key"]="$name"
      dsecs+=("$secs"); dsize+=("$(stat -c %s "$dest/$name")"); dname+=("$name")
      echo "Episode: $name  ($secs s)"
      advance "$((part + 1))"
    fi
  elif [ "$KEEP_EXTRAS" = "0" ] && [ "$secs" -lt "$minsecs" ]; then
    rm -f "$f"
    echo "Deleted extra: $(basename "$f")  ($secs s)"
  else
    to_extras "$f"
    echo "Extra:   $(basename "$f")  ($secs s)"
  fi
done

if [ "$part" -gt 0 ]; then
  echo "WARNING split episode: e$ep has only $part of its $(nparts "$ep") parts on this disc, so it isn't counted yet. If its other part is on the next disc, check that disc's numbering by hand."
fi
rm -f "$src/.done" "$src/.pending" "$src/.sorting" "$progress"
rmdir "$src" 2>/dev/null || echo "Left $src in place (not empty)."
echo "Episodes from this disc: $found"
echo "EPISODES=$found"
