#!/bin/bash
set -uo pipefail

LAB="git --git-dir=$HOME/.labrepo --work-tree=$HOME"
LOG="$HOME/homelab/logs/labsync.log"
T=$(cat "$HOME/.ntfy-topic" 2>/dev/null)

if [ -z "$T" ]; then
  echo "$(date -Is) BLOCKED no topic file to check against" >> "$LOG"
  exit 1
fi

$LAB add -u

if $LAB diff --cached --quiet; then
  echo "$(date -Is) OK nothing to commit" >> "$LOG"
  exit 0
fi

if $LAB grep --cached -q -F "$T"; then
  $LAB reset -q
  echo "$(date -Is) BLOCKED topic found in tracked files" >> "$LOG"
  exit 1
fi

$LAB commit -q -m "Auto: $(date +%F)"

if $LAB push -q origin main; then
  echo "$(date -Is) OK pushed" >> "$LOG"
else
  echo "$(date -Is) FAILED push" >> "$LOG"
  exit 1
fi
