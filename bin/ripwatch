#!/usr/bin/env bash
# Run by cron every minute. Sorts any rip folder containing a .done marker.
# TV discs: show, season and disc number come from the disc label. Each sorted
# disc records its episode count in "Season NN/.discs"; the next disc numbers on
# from the discs before it, and a disc whose predecessors are missing waits
# (.pending) until they arrive. A label with a show and season but no disc
# number is assumed to be the next disc after those already sorted (reported
# as "assumed disc N"; an assumed disc with no new episodes is treated as a
# re-rip and not recorded). TOTAL_S<n> in the show's .ripsort caps the
# numbering; DISCS_S<n> (optional) fixes the layout instead. Unknown shows are
# parked and reported; run newseries to resolve.
# Studio-code labels (e.g. EC_108887) are mapped to a show and season in
# ~/.config/ripsort/labels, one per line: LABEL|Show Name|SEASON
# MakeMKV's random "-XXXXXX" suffix on repeat labels is ignored for the lookup.
# A label with no show name or no season is parked (.pending) for relabel; the
# old series.conf fallback (and its MODE switch) is no longer read.
# Markers: .done is renamed to .sorting while a sort runs. Success removes the
# folder; a failed sort leaves .failed holding the reason (and keeps .film). A
# .sorting left behind by a sort that was killed becomes .failed on the next run.
set -uo pipefail

LABELS="$HOME/.config/ripsort/labels"
LOG="$HOME/.config/ripsort/ripwatch.log"
TOPIC=$(cat "$HOME/.ntfy-rips-topic" 2>/dev/null)
RIPS="/srv/media/rips"
TV="$RIPS/tv"

exec 9>"$HOME/.config/ripsort/.lock"
flock -n 9 || exit 0

# Phone alerts. A missing topic file or a failed send is written to the log
# (it shows under Recent sorts on the dashboard) and to stderr, which cron
# mails, so it is never silent.
warn_notify() {  # $1 = problem, $2 = how to fix, $3 = command, $4 = the unsent message
  printf '\n== %s  ntfy ==\nProblem: %s\nHow to fix it: %s\n\n    %s\n\nNothing was changed. This message was not sent to your phone:\n%s\n' \
    "$(date '+%F %T')" "$1" "$2" "$3" "$4" | tee -a "$LOG" >&2
}
notify() {
  if [ -z "$TOPIC" ]; then
    warn_notify "there is no ntfy topic in ~/.ntfy-rips-topic, so phone alerts can't be sent." \
      "Put your topic name in the file (change mytopic to yours):" "echo mytopic > ~/.ntfy-rips-topic" "$1"
    return 1
  fi
  curl -fsS -m 10 -d "$1" "https://ntfy.sh/$TOPIC" >/dev/null 2>&1 && return 0
  warn_notify "couldn't reach ntfy.sh within 10 seconds, so a phone alert wasn't sent." \
    "Check the server can reach ntfy (200 means it can):" "curl -sS -m 10 -o /dev/null -w '%{http_code}\n' https://ntfy.sh/" "$1"
  return 1
}
# Normalise a name for matching: lowercase, drop leading "the", drop
# non-alphanumerics, drop a trailing "s" so SIMPSON and SIMPSONS match.
norm()   { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/^the //; s/[^a-z0-9]//g; s/s$//'; }

# Look up a label in the labels file; prints "Show Name|SEASON" on a match.
lookup_label() {
  [ -f "$LABELS" ] || return 1
  awk -F'|' -v k="$1" 'toupper($1)==toupper(k) && NF>=3 {print $2 "|" $3; found=1; exit} END{exit !found}' "$LABELS"
}

# Parse a disc label into SHOW_RAW / SEASON / DISC (any may come back empty).
parse_label() {
  local label="$1" up hit base
  base=$(printf '%s' "$label" | sed -E 's/-[A-Za-z0-9]{6}$//')
  hit=$(lookup_label "$label") || hit=$(lookup_label "$base") || hit=""
  if [ -n "$hit" ]; then
    SHOW_RAW="${hit%%|*}"; SEASON="${hit#*|}"; DISC=""
    return 0
  fi
  up=$(printf '%s' "$label" | tr '[:lower:]' '[:upper:]' | tr ' -' '__')
  SEASON=$(printf '%s' "$up" | sed -nE 's/.*(SEASON|SERIES|S)_*0*([0-9]{1,2})(_|$|D).*/\2/p' | head -n1)
  DISC=$(printf '%s' "$up" | sed -nE 's/.*(DISC|DISK|D)_*0*([0-9]{1,2})(_|$).*/\2/p' | head -n1)
  SHOW_RAW=$(printf '%s' "$up" | sed -E 's/_*(SEASON|SERIES|S)_*[0-9]{1,2}.*$//; s/_*(DISC|DISK|D)_*[0-9]{1,2}.*$//; s/_+/ /g; s/^ +| +$//g')
  case "$SHOW_RAW" in DVD*VIDEO*|DVD|VIDEO|DISC*|UNTITLED*) SHOW_RAW="" ;; esac
}

# True if a label parses to the given show and season (runs in a subshell so
# the caller's parsed values are untouched).
label_is() {
  ( parse_label "$1"; s=$(find_show "$SHOW_RAW") || s=""; [ "$s" = "$2" ] && [ "$SEASON" = "$3" ] )
}

# Find an existing show folder whose normalised name matches.
find_show() {
  local want; want=$(norm "$1")
  [ -z "$want" ] && return 1
  local d
  for d in "$TV"/*/; do
    [ -d "$d" ] || continue
    local name; name=$(basename "$d")
    if [ "$(norm "$name")" = "$want" ]; then printf '%s' "$name"; return 0; fi
    if grep -qiE "^ALIASES=.*\b$want\b" "$d.ripsort" 2>/dev/null; then printf '%s' "$name"; return 0; fi
  done
  return 1
}

# A failed sort. Sets FAIL_FILE, the .failed marker's text (line 1: who wrote
# it and why; line 2: "Fix: " and the command; then the details), and FAIL_MSG,
# the notification, which starts with "Problem:". The fix is the tool's own
# first command when it printed a How to fix it, otherwise a retry.
fail_text() {  # $1 = reason (one line), $2 = tool output (may be empty), $3 = rip folder path
  local fix how details cmd
  fix="rm -f \"$3/.failed\" && touch \"$3/.done\""
  how="How to fix it: fix the cause above, then queue it again. Anything already filed is kept, and TV numbering carries on where it stopped:

    $fix

Some files may already have been filed; the rest are still in $3."
  details=$(printf '%s\n' "$2" | sed '0,/^Problem: /{/^Problem: /d}')
  if printf '%s\n' "$2" | grep -q '^How to fix it:'; then
    cmd=$(printf '%s\n' "$2" | sed -n 's/^    \([^ ].*\)$/\1/p' | head -n1)
    [ -n "$cmd" ] && fix="$cmd"
    how=""
  fi
  FAIL_MSG="Problem: sorting $(basename "$3") failed: $1"
  [ -n "$details" ] && FAIL_MSG="$FAIL_MSG
$details"
  [ -n "$how" ] && FAIL_MSG="$FAIL_MSG
$how"
  FAIL_FILE="ripwatch: sort failed: $1
Fix: $fix

$FAIL_MSG"
}

# A .sorting marker here means a sort was killed (reboot, crash) before it
# finished; this run holds the lock, so no sort is running now.
for stale in "$RIPS"/*/.sorting; do
  [ -e "$stale" ] || continue
  sdir=$(dirname "$stale")
  fail_text "the sort was interrupted (reboot or crash) before it finished." "" "$sdir"
  printf '%s\n' "$FAIL_FILE" > "$sdir/.failed" && rm -f "$stale"
  printf "\n== %s  %s ==\n%s\n" "$(date '+%F %T')" "$(basename "$sdir")" "$FAIL_MSG" >> "$LOG"
  notify "$FAIL_MSG"
done

for marker in "$RIPS"/*/.done; do
  [ -e "$marker" ] || continue
  dir=$(dirname "$marker"); folder=$(basename "$dir")
  mv "$marker" "$dir/.sorting" || continue
  out=""
  assumed=""
  failed=""

  # A rip started as a film (rescuerip --film) carries its title in .film
  # and goes to Movies whatever the mode. sortfilm removes .film only once
  # the film is filed.
  if [ -f "$dir/.film" ]; then
    ftitle=$(head -n1 "$dir/.film")
    if out=$("$HOME/bin/sortfilm" "$folder" "$ftitle" 2>&1); then
      "$HOME/bin/engdefault" "$RIPS/movies/$ftitle" >/dev/null 2>&1
    else
      rc=$?
      reason=$(printf '%s\n' "$out" | sed -n 's/^Problem: //p' | head -n1)
      fail_text "${reason:-sortfilm stopped before finishing (exit code $rc).}" "$out" "$dir"; failed=1
    fi
  else
      # Otherwise it is TV.
      parse_label "$folder"
      show=$(find_show "$SHOW_RAW") || show=""

      unset MIN_MINUTES MAX_MINUTES "${!MAX_MINUTES_S@}"; unset "${!DISCS_S@}" "${!TOTAL_S@}"
      cfg="$TV/${show:-_}/.ripsort"
      # shellcheck source=/dev/null
      [ -n "$show" ] && [ -f "$cfg" ] && source "$cfg"
      min="${MIN_MINUTES:-18}"
      max="${MAX_MINUTES:-$((min + 5))}"
      maxs="MAX_MINUTES_S${SEASON:-0}"; max="${!maxs:-$max}"
      seasondir=$(printf "%s/%s/Season %02d" "$TV" "${show:-_}" "${SEASON:-0}")
      record="$seasondir/.discs"
      first=""; last=""; parked=""

      # Season but no disc number: assume the next disc after those already sorted.
      if [ -n "$show" ] && [ -n "$SEASON" ] && [ -z "$DISC" ]; then
        maxd=0
        if [ -f "$record" ]; then
          maxd=$(awk 'BEGIN{m=0} $1+0>m{m=$1+0} END{print m}' "$record")
        fi
        DISC=$((maxd + 1))
        assumed="Label has no disc number, so assumed disc $DISC (next after the discs already sorted). If that's wrong, tell Claude before ripping more of this series."
      fi

      mapvar="DISCS_S${SEASON:-0}"; totvar="TOTAL_S${SEASON:-0}"
      read -ra counts <<< "${!mapvar:-}"
      total="${!totvar:-}"

      asfilm="If it's a film, not TV, file it as a film instead (put in its title and year):

    echo \"Title (Year)\" > \"$dir/.film\" && mv \"$dir/.pending\" \"$dir/.done\""
      if [ -z "$SHOW_RAW" ]; then
        parked="Problem: Unreadable label: $folder has no show name in it (a generic disc label), so it can't be sorted.
How to fix it: relabel it with the season, disc and show (change these to match the disc), and it sorts within a minute:

    ~/bin/relabel $folder ${SEASON:-1} ${DISC:-1} \"Show Name\"

$asfilm

Nothing was changed. The rip is parked as .pending."
      elif [ -z "$show" ]; then
        parked="Problem: Unknown show: $folder (label show '$SHOW_RAW') doesn't match any show folder.
How to fix it: for a new show, set it up (change the season and episode total), and it sorts within a minute:

    ~/bin/newseries \"Show Name\" ${SEASON:-1} 10

For a show you already have under another name, relabel it:

    ~/bin/relabel $folder ${SEASON:-1} ${DISC:-1} \"Show Name\"

For a studio-code label, add LABEL|Show Name|SEASON to ~/.config/ripsort/labels instead.
$asfilm

Nothing was changed. The rip is parked as .pending."
      elif [ -z "$SEASON" ] || [ -z "$DISC" ]; then
        parked="Problem: Unreadable label: $folder has no season number, so it can't be sorted.
How to fix it: relabel it with the season and disc (change these to match the disc), and it sorts within a minute:

    ~/bin/relabel $folder 1 ${DISC:-1} \"$show\"

Nothing was changed. The rip is parked as .pending."
      elif [ -f "$record" ] && grep -q "^$DISC " "$record"; then
        parked="Problem: Disc $DISC of $show series $SEASON was already sorted, so $folder looks like a second rip of it.
How to fix it: if the disc number in the label is wrong, relabel it (change the disc number):

    ~/bin/relabel $folder $SEASON $DISC \"$show\"

If it really is a second rip you don't need, delete it:

    rm -r \"$dir\"

Nothing was changed. The rip is parked as .pending."
      elif [ "${#counts[@]}" -gt 0 ]; then
        if [ "$DISC" -gt "${#counts[@]}" ]; then
          parked="Problem: Disc $DISC is outside the series $SEASON disc map for $show, which has ${#counts[@]} discs (${counts[*]}).
How to fix it: if the label's disc number is right, set the series up again with every disc's episode count (change the total and the counts), and it sorts within a minute:

    ~/bin/newseries \"$show\" $SEASON ${total:-TOTAL} \"${counts[*]} N\"

If the label is wrong, relabel it instead:

    ~/bin/relabel $folder $SEASON 1 \"$show\"

Nothing was changed. The rip is parked as .pending."
        else
          first=1; i=0
          for c in "${counts[@]}"; do
            [ "$i" -lt "$((DISC - 1))" ] && first=$((first + c))
            i=$((i + 1))
          done
          last=$((first + counts[DISC - 1] - 1))
        fi
      else
        first=1; d=1
        while [ "$d" -lt "$DISC" ]; do
          n=$(grep "^$d " "$record" 2>/dev/null | awk '{print $2}')
          if [ -z "$n" ]; then
            parked="Disc $DISC of $show series $SEASON is waiting for disc $d to be ripped first."
            break
          fi
          first=$((first + n)); d=$((d + 1))
        done
        last="$total"
      fi

      if [ -n "$parked" ]; then
        touch "$dir/.pending"
        out="$parked"
      elif [ -n "$first" ]; then
        out=$("$HOME/bin/sorttv" "$folder" "$show" "$SEASON" "$first" "$min" "$max" "$last" 2>&1); rc=$?
        found=$(printf '%s\n' "$out" | sed -n 's/^EPISODES=\([0-9]*\)$/\1/p' | tail -n1)
        out=$(printf '%s\n' "$out" | grep -v '^EPISODES=')
        [ "$rc" -ne 0 ] && found=""
        if [ "$rc" -eq 3 ]; then
          # sorttv found a title it can't read the length of and moved nothing.
          touch "$dir/.pending"
        elif [ -z "$found" ]; then
          fail_text "sorttv stopped before finishing (exit code $rc), so nothing was recorded in .discs." "$out" "$dir"; failed=1
        elif [ -n "$assumed" ] && [ "$found" -eq 0 ]; then
          out="$out
No new episodes on this disc, so it is probably a re-rip of a disc already sorted. Nothing recorded."
        else
          mkdir -p "$seasondir"
          printf '%s %s\n' "$DISC" "$found" >> "$record"
          "$HOME/bin/engdefault" "$seasondir" >/dev/null 2>&1
          # Distinct episode numbers, so a split episode's part files count once.
          have=$(ls "$seasondir"/*.mkv 2>/dev/null | sed -nE 's/.* - s[0-9]+e([0-9]+)( - part[0-9]+)?\.mkv$/\1/p' | sort -u | wc -l)
          out="$out
Disc $DISC: $found episodes from e$first. Series $SEASON: $have of ${total:-?} on disk."
          [ "$found" -eq 0 ] && out="$out
WARNING: no episode-length titles found on this disc."
          # Re-queue any discs of this show and series that were waiting.
          for p in "$RIPS"/*/.pending; do
            [ -e "$p" ] || continue
            if label_is "$(basename "$(dirname "$p")")" "$show" "$SEASON"; then
              mv "$p" "$(dirname "$p")/.done"
            fi
          done
        fi
      fi
  fi

  # Finish with the markers: .failed with the reason, or just drop .sorting
  # (parked rips already have .pending; a sorted rip's folder is gone).
  if [ -n "$failed" ]; then
    out="$FAIL_MSG"
    [ -d "$dir" ] && printf '%s\n' "$FAIL_FILE" > "$dir/.failed" && rm -f "$dir/.sorting"
  elif [ -d "$dir" ]; then
    rm -f "$dir/.sorting"
  fi

  # A problem goes out starting with "Problem:"; anything else is prefixed with
  # the folder name as before.
  if [ "${out#Problem:}" != "$out" ]; then
    [ -n "$assumed" ] && out="$out

Note: $assumed"
    msg="$out"
  else
    [ -n "$assumed" ] && out="$assumed
$out"
    msg="$folder
$out"
  fi
  printf "\n== %s  %s ==\n%s\n" "$(date '+%F %T')" "$folder" "$out" >> "$LOG"
  notify "$msg"
done
