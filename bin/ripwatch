#!/usr/bin/env bash
# Run by cron every minute. Sorts any rip folder containing a .done marker.
# TV discs: show, season and disc number come from the disc label. The first
# episode number comes from the show's .ripsort season map (episodes per disc),
# so discs can arrive in any order. Discs the map cannot place are parked
# (.pending) and reported; run newseries to resolve.
set -uo pipefail

CONF="$HOME/.config/ripsort/series.conf"
LOG="$HOME/.config/ripsort/ripwatch.log"
TOPIC=$(cat "$HOME/.ntfy-rips-topic")
RIPS="/srv/media/rips"
TV="$RIPS/tv"

exec 9>"$HOME/.config/ripsort/.lock"
flock -n 9 || exit 0

notify() { curl -s -d "$1" "https://ntfy.sh/$TOPIC" >/dev/null; }
# Normalise a name for matching: lowercase, drop leading "the", drop
# non-alphanumerics, drop a trailing "s" so SIMPSON and SIMPSONS match.
norm()   { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/^the //; s/[^a-z0-9]//g; s/s$//'; }

# Parse a disc label into SHOW_RAW / SEASON / DISC (any may come back empty).
parse_label() {
  local label="$1" up
  up=$(printf '%s' "$label" | tr '[:lower:]' '[:upper:]' | tr ' -' '__')
  SEASON=$(printf '%s' "$up" | sed -nE 's/.*(SEASON|SERIES|S)_*0*([0-9]{1,2})(_|$|D).*/\2/p' | head -n1)
  DISC=$(printf '%s' "$up" | sed -nE 's/.*(DISC|DISK|D)_*0*([0-9]{1,2})(_|$).*/\2/p' | head -n1)
  SHOW_RAW=$(printf '%s' "$up" | sed -E 's/_*(SEASON|SERIES|S)_*[0-9]{1,2}.*$//; s/_*(DISC|DISK|D)_*[0-9]{1,2}.*$//; s/_+/ /g; s/^ +| +$//g')
  case "$SHOW_RAW" in DVD*VIDEO*|DVD|VIDEO|DISC*|UNTITLED*) SHOW_RAW="" ;; esac
}

# Find an existing show folder whose normalised name matches.
find_show() {
  local want; want=$(norm "$1")
  [ -z "$want" ] && return 1
  local d
  for d in "$TV"/*/; do
    [ -d "$d" ] || continue
    local name; name=$(basename "$d")
    if [ "$(norm "$name")" = "$want" ]; then printf '%s' "$name"; return 0; fi
  done
  return 1
}

for marker in "$RIPS"/*/.done; do
  [ -e "$marker" ] || continue
  dir=$(dirname "$marker"); folder=$(basename "$dir")
  rm -f "$marker"
  # shellcheck source=/dev/null
  source "$CONF"
  out=""

  case "${MODE:-off}" in
    off)
      out="Sorting is off. $folder left in place." ;;
    film)
      out=$("$HOME/bin/sortfilm" "$folder" "$TITLE" 2>&1) ;;
    tv)
      parse_label "$folder"
      show=$(find_show "$SHOW_RAW") || show=""
      # Fallback to series.conf when the label gives no usable show name.
      if [ -z "$show" ] && [ -n "${SHOW:-}" ] && { [ -z "$SHOW_RAW" ] || [ "$(norm "$SHOW")" = "$(norm "$SHOW_RAW")" ]; }; then
        show="$SHOW"
      fi
      [ -z "$SEASON" ] && SEASON="${SEASON_DEFAULT:-}"

      unset MIN_MINUTES MAX_MINUTES; unset "${!DISCS_S@}"
      cfg="$TV/${show:-_}/.ripsort"
      # shellcheck source=/dev/null
      [ -n "$show" ] && [ -f "$cfg" ] && source "$cfg"
      var="DISCS_S${SEASON:-0}"
      read -ra counts <<< "${!var:-}"
      helpmsg="Run: newseries \"${show:-Show Name}\" ${SEASON:-SEASON} \"EPS_PER_DISC\"  (e.g. \"6 7 7 5\") then it will sort."

      if [ -z "$show" ] || [ -z "$SEASON" ] || [ -z "$DISC" ]; then
        touch "$dir/.pending"
        out="Unknown disc: $folder (show='${SHOW_RAW:-?}', season='${SEASON:-?}', disc='${DISC:-?}'). Label needs show, season and disc. $helpmsg"
      elif [ ! -f "$cfg" ]; then
        touch "$dir/.pending"
        out="No .ripsort for $show. $helpmsg"
      elif [ "${#counts[@]}" -eq 0 ]; then
        touch "$dir/.pending"
        out="No season $SEASON map for $show. $helpmsg"
      elif [ "$DISC" -lt 1 ] || [ "$DISC" -gt "${#counts[@]}" ]; then
        touch "$dir/.pending"
        out="Disc $DISC is outside the season $SEASON map for $show (${#counts[@]} discs: ${counts[*]}). Fix the map with newseries, then it will sort."
      else
        first=1; total=0; i=0
        for c in "${counts[@]}"; do
          total=$((total + c))
          [ "$i" -lt "$((DISC - 1))" ] && first=$((first + c))
          i=$((i + 1))
        done
        expected=${counts[$((DISC - 1))]}
        min="${MIN_MINUTES:-18}"
        max="${MAX_MINUTES:-$((min + 5))}"
        out=$("$HOME/bin/sorttv" "$folder" "$show" "$SEASON" "$first" "$min" "$max" "$expected" 2>&1)
        seasondir=$(printf "%s/%s/Season %02d" "$TV" "$show" "$SEASON")
        have=$(ls "$seasondir"/*.mkv 2>/dev/null | wc -l)
        out="$out
Disc $DISC of ${#counts[@]} (episodes $first-$((first + expected - 1))). Season $SEASON: $have of $total on disk."
        if [ "$DISC" -eq "${#counts[@]}" ] && [ "$have" -ne "$total" ]; then
          out="$out
WARNING: last disc sorted but the season count does not match."
        fi
      fi ;;
  esac

  printf "\n== %s  %s ==\n%s\n" "$(date '+%F %T')" "$folder" "$out" >> "$LOG"
  notify "$folder
$out"
done
