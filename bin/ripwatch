#!/usr/bin/env bash
# Run by cron every minute. Sorts any rip folder containing a .done marker.
# TV discs: show, season and disc number come from the disc label. Each sorted
# disc records its episode count in "Season NN/.discs"; the next disc numbers on
# from the discs before it, and a disc whose predecessors are missing waits
# (.pending) until they arrive. A label with a show and season but no disc
# number is assumed to be the next disc after those already sorted (reported
# as "assumed disc N"; an assumed disc with no new episodes is treated as a
# re-rip and not recorded). TOTAL_S<n> in the show's .ripsort caps the
# numbering; DISCS_S<n> (optional) fixes the layout instead. Unknown shows are
# parked and reported; run newseries to resolve.
set -uo pipefail

CONF="$HOME/.config/ripsort/series.conf"
LOG="$HOME/.config/ripsort/ripwatch.log"
TOPIC=$(cat "$HOME/.ntfy-rips-topic")
RIPS="/srv/media/rips"
TV="$RIPS/tv"

exec 9>"$HOME/.config/ripsort/.lock"
flock -n 9 || exit 0

notify() { curl -s -d "$1" "https://ntfy.sh/$TOPIC" >/dev/null; }
# Normalise a name for matching: lowercase, drop leading "the", drop
# non-alphanumerics, drop a trailing "s" so SIMPSON and SIMPSONS match.
norm()   { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/^the //; s/[^a-z0-9]//g; s/s$//'; }

# Parse a disc label into SHOW_RAW / SEASON / DISC (any may come back empty).
parse_label() {
  local label="$1" up
  up=$(printf '%s' "$label" | tr '[:lower:]' '[:upper:]' | tr ' -' '__')
  SEASON=$(printf '%s' "$up" | sed -nE 's/.*(SEASON|SERIES|S)_*0*([0-9]{1,2})(_|$|D).*/\2/p' | head -n1)
  DISC=$(printf '%s' "$up" | sed -nE 's/.*(DISC|DISK|D)_*0*([0-9]{1,2})(_|$).*/\2/p' | head -n1)
  SHOW_RAW=$(printf '%s' "$up" | sed -E 's/_*(SEASON|SERIES|S)_*[0-9]{1,2}.*$//; s/_*(DISC|DISK|D)_*[0-9]{1,2}.*$//; s/_+/ /g; s/^ +| +$//g')
  case "$SHOW_RAW" in DVD*VIDEO*|DVD|VIDEO|DISC*|UNTITLED*) SHOW_RAW="" ;; esac
}

# True if a label parses to the given show and season (runs in a subshell so
# the caller's parsed values are untouched).
label_is() {
  ( parse_label "$1"; [ "$(norm "$SHOW_RAW")" = "$(norm "$2")" ] && [ "$SEASON" = "$3" ] )
}

# Find an existing show folder whose normalised name matches.
find_show() {
  local want; want=$(norm "$1")
  [ -z "$want" ] && return 1
  local d
  for d in "$TV"/*/; do
    [ -d "$d" ] || continue
    local name; name=$(basename "$d")
    if [ "$(norm "$name")" = "$want" ]; then printf '%s' "$name"; return 0; fi
  done
  return 1
}

for marker in "$RIPS"/*/.done; do
  [ -e "$marker" ] || continue
  dir=$(dirname "$marker"); folder=$(basename "$dir")
  rm -f "$marker"
  # shellcheck source=/dev/null
  source "$CONF"
  out=""
  assumed=""

  case "${MODE:-off}" in
    off)
      out="Sorting is off. $folder left in place." ;;
    film)
      out=$("$HOME/bin/sortfilm" "$folder" "$TITLE" 2>&1) ;;
    tv)
      parse_label "$folder"
      show=$(find_show "$SHOW_RAW") || show=""
      # Fallback to series.conf when the label gives no usable show name.
      if [ -z "$show" ] && [ -n "${SHOW:-}" ] && { [ -z "$SHOW_RAW" ] || [ "$(norm "$SHOW")" = "$(norm "$SHOW_RAW")" ]; }; then
        show="$SHOW"
      fi
      [ -z "$SEASON" ] && SEASON="${SEASON_DEFAULT:-}"

      unset MIN_MINUTES MAX_MINUTES; unset "${!DISCS_S@}" "${!TOTAL_S@}"
      cfg="$TV/${show:-_}/.ripsort"
      # shellcheck source=/dev/null
      [ -n "$show" ] && [ -f "$cfg" ] && source "$cfg"
      min="${MIN_MINUTES:-18}"
      max="${MAX_MINUTES:-$((min + 5))}"
      seasondir=$(printf "%s/%s/Season %02d" "$TV" "${show:-_}" "${SEASON:-0}")
      record="$seasondir/.discs"
      first=""; last=""; parked=""

      # Season but no disc number: assume the next disc after those already sorted.
      if [ -n "$show" ] && [ -n "$SEASON" ] && [ -z "$DISC" ]; then
        maxd=0
        if [ -f "$record" ]; then
          maxd=$(awk 'BEGIN{m=0} $1+0>m{m=$1+0} END{print m}' "$record")
        fi
        DISC=$((maxd + 1))
        assumed="Label has no disc number, so assumed disc $DISC (next after the discs already sorted). If that's wrong, tell Claude before ripping more of this series."
      fi

      mapvar="DISCS_S${SEASON:-0}"; totvar="TOTAL_S${SEASON:-0}"
      read -ra counts <<< "${!mapvar:-}"
      total="${!totvar:-}"

      if [ -z "$show" ]; then
        parked="Unknown show: $folder (label show='${SHOW_RAW:-?}'). Run: newseries \"Show Name\" SEASON TOTAL  then it will sort."
      elif [ -z "$SEASON" ] || [ -z "$DISC" ]; then
        parked="Unreadable label: $folder (season='${SEASON:-?}', disc='${DISC:-?}'). Label needs S<n> and D<n>; or sort by hand with sorttv."
      elif [ -f "$record" ] && grep -q "^$DISC " "$record"; then
        out="Disc $DISC of $show series $SEASON was already sorted. $folder left in place."
      elif [ "${#counts[@]}" -gt 0 ]; then
        if [ "$DISC" -gt "${#counts[@]}" ]; then
          parked="Disc $DISC is outside the series $SEASON disc map for $show (${counts[*]}). Fix .ripsort, then it will sort."
        else
          first=1; i=0
          for c in "${counts[@]}"; do
            [ "$i" -lt "$((DISC - 1))" ] && first=$((first + c))
            i=$((i + 1))
          done
          last=$((first + counts[DISC - 1] - 1))
        fi
      else
        first=1; d=1
        while [ "$d" -lt "$DISC" ]; do
          n=$(grep "^$d " "$record" 2>/dev/null | awk '{print $2}')
          if [ -z "$n" ]; then
            parked="Disc $DISC of $show series $SEASON is waiting for disc $d to be ripped first."
            break
          fi
          first=$((first + n)); d=$((d + 1))
        done
        last="$total"
      fi

      if [ -n "$parked" ]; then
        touch "$dir/.pending"
        out="$parked"
      elif [ -n "$first" ]; then
        out=$("$HOME/bin/sorttv" "$folder" "$show" "$SEASON" "$first" "$min" "$max" "$last" 2>&1)
        found=$(printf '%s\n' "$out" | sed -n 's/^EPISODES=\([0-9]*\)$/\1/p' | tail -n1)
        out=$(printf '%s\n' "$out" | grep -v '^EPISODES=')
        if [ -n "$found" ] && [ -n "$assumed" ] && [ "$found" -eq 0 ]; then
          out="$out
No new episodes on this disc, so it is probably a re-rip of a disc already sorted. Nothing recorded."
        elif [ -n "$found" ]; then
          mkdir -p "$seasondir"
          printf '%s %s\n' "$DISC" "$found" >> "$record"
          have=$(ls "$seasondir"/*.mkv 2>/dev/null | wc -l)
          out="$out
Disc $DISC: $found episodes from e$first. Series $SEASON: $have of ${total:-?} on disk."
          [ "$found" -eq 0 ] && out="$out
WARNING: no episode-length titles found on this disc."
          # Re-queue any discs of this show and series that were waiting.
          for p in "$RIPS"/*/.pending; do
            [ -e "$p" ] || continue
            if label_is "$(basename "$(dirname "$p")")" "$show" "$SEASON"; then
              mv "$p" "$(dirname "$p")/.done"
            fi
          done
        else
          out="$out
WARNING: sorttv did not complete; nothing recorded. $folder left in place."
        fi
      fi ;;
  esac

  [ -n "$assumed" ] && out="$assumed
$out"
  printf "\n== %s  %s ==\n%s\n" "$(date '+%F %T')" "$folder" "$out" >> "$LOG"
  notify "$folder
$out"
done
